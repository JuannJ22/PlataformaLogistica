<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/23"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="co.edu.uniquindio.poo.plataformalogistica.viewController.LoginViewController"
           stylesheets="@login.css"
           styleClass="root">

    <children>
        <!-- Tarjeta centrada -->
        <VBox alignment="CENTER"
              spacing="18.0"
              maxWidth="420"
              styleClass="login-card">

            <Label text="Plataforma de Logística"
                   styleClass="title"/>

            <Label text="Iniciar sesión"
                   styleClass="subtitle"/>

            <TextField fx:id="txtUsuario"
                       promptText="Usuario (correo)"
                       maxWidth="Infinity"
                       styleClass="input"/>

            <PasswordField fx:id="txtContrasena"
                           promptText="Contraseña"
                           maxWidth="Infinity"
                           styleClass="input"/>

            <Button fx:id="btnIngresar"
                    text="Ingresar"
                    maxWidth="Infinity"
                    styleClass="primary-button"/>

            <Label fx:id="lblError"
                   alignment="CENTER"
                   maxWidth="Infinity"
                   wrapText="true"
                   styleClass="error-label"/>
        </VBox>
    </children>
</StackPane>
